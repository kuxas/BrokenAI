int digit_sum(int x) {
    int s = 0;
    while (x > 0) {
        s += x % 10;
        x /= 10;
    }
    return s;
}

int main() {
    int n, a, b;
    cin >> n >> a >> b;

    int ans = 0;
    for (int x = 1; x <= n; x++) {
        int s = digit_sum(x);
        if (a <= s && s <= b) ans += x;
    }

    cout << ans << '\n';
}
